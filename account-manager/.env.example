# Postgres. The app is a superuser here on purpose (it creates a database per
# agency); lib/rls.js drops to the unprivileged am_app role for every request
# so the policies in schema.sql actually apply.
DATABASE_URL=postgres://user:pass@host:5432/railway

# Sign tokens with this. Leave it unset in production and every token is forgeable.
SESSION_SECRET=

# Telegram. Without a token the bot and Mini App go quiet and the rest works.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
PUBLIC_URL=https://your-app.up.railway.app

# Files. Point at the Railway volume so uploads survive a redeploy.
FILES_DIR=/data/files
BACKUP_DIR=/data/backups
FILE_MAX_MB=25

PLATFORM_ADMIN_KEY=
